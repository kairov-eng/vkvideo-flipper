{
  "manifest_version": 3,
  "name": "VKVideo flipper",
  "description": "Отражает видео VK по горизонтали. Автоанализ по OCR находит зеркальный текст в кадре и включает flip только когда это нужно.",
  "version": "1.3.9",
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "*://vkvideo.ru/*",
    "*://*.vkvideo.ru/*",
    "*://vk.com/*",
    "*://*.vk.com/*",
    "*://vk.ru/*",
    "*://*.vk.ru/*",
    "*://yandex.ru/*",
    "*://*.yandex.ru/*",
    "*://ya.ru/*",
    "*://*.ya.ru/*",
    "https://us.i.posthog.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VKVideo flipper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-flip": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Включить или выключить отражение видео"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://vkvideo.ru/*",
        "*://*.vkvideo.ru/*",
        "*://vk.com/*",
        "*://*.vk.com/*",
        "*://vk.ru/*",
        "*://*.vk.ru/*",
        "*://yandex.ru/*",
        "*://*.yandex.ru/*",
        "*://ya.ru/*",
        "*://*.ya.ru/*"
      ],
      "js": ["open-shadow.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://vkvideo.ru/*",
        "*://*.vkvideo.ru/*",
        "*://vk.com/*",
        "*://*.vk.com/*",
        "*://vk.ru/*",
        "*://*.vk.ru/*",
        "*://yandex.ru/*",
        "*://*.yandex.ru/*",
        "*://ya.ru/*",
        "*://*.ya.ru/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "lang/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
